{
  "name": "interactive-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:verify": "tsc -b && vite build --mode verify",
    "pages": "node scripts/optimize-pages.mjs",
    "plates": "node scripts/optimize-pages.mjs --plates",
    "anims": "node scripts/optimize-anims.mjs",
    "projects": "node scripts/optimize-projects.mjs && node scripts/make-cover-stills.mjs",
    "covers": "node scripts/make-cover-stills.mjs",
    "backgrounds": "node scripts/optimize-backgrounds.mjs",
    "placeholders": "node scripts/make-placeholders.mjs",
    "creases": "node scripts/make-crease-map.mjs",
    "chrome": "node scripts/make-chrome.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "verify:pv": "node scripts/pv-verify.mjs",
    "verify:gpu": "node scripts/pv-gpu-loop.mjs",
    "verify:reader": "node scripts/reader-verify.mjs",
    "verify:detail": "node scripts/detail-verify.mjs",
    "verify:sky": "node scripts/sky-fluid-verify.mjs",
    "verify:cover": "node scripts/cover-verify.mjs",
    "verify:jank": "node scripts/jank-check.mjs",
    "preview": "vite preview",
    "preview:verify": "vite preview --mode verify"
  },
  "dependencies": {
    "@rive-app/canvas": "^2.42.1",
    "dialkit": "^2.0.0",
    "lenis": "^1.3.26",
    "motion": "^12.40.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.8"
  }
}
